   "options": "<meta charset=\"UTF-8\">\n<title>\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 - \u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0627\u0644\u0628\u062d\u062b</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Tajawal:wght@500&amp;display=swap\" rel=\"stylesheet\">\n<style>\n  body {\n    font-family: 'Tajawal', sans-serif;\n    direction: rtl;\n    text-align: right;\n    margin: 40px;\n    position: relative;\n    background-image:http://localhost:8000/files/398187124_832924115292771_8632611931367621524_n.png;\n\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: 75%;\n    color: #111;\n  }\n  .section {\n    border: 1px solid #999;\n    padding: 15px;\n    margin-bottom: 25px;\n    background: rgba(255,255,255,0.85);\n  }\n  .checkbox {\n    display: inline-block;\n    width: 18px;\n    height: 18px;\n    border: 1px solid #000;\n    margin: 0 5px;\n  }\n  .signature {\n    margin-top: 15px;\n    display: flex;\n    justify-content: space-between;\n  }\n  .signature div {\n    width: 45%;\n  }\n  .note {\n    font-size: 14px;\n    margin-top: 10px;\n  }\n  h3 {\n    margin-bottom: 10px;\n    color: #222;\n  }\n</style>\n\n\n\n<!-- \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0623\u0648\u0644 -->\n<div class=\"section\">\n  <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629:</h3>\n  \u0623\u0648\u0635\u062a \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0633\u0645 \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0627\u0644\u0645\u0631\u0642\u0645\u0629 (\n  <span style=\"display:inline-block; width:50px; border-bottom:1px solid #000;\"></span> ) \u0628\u062a\u0627\u0631\u064a\u062e\n  <span style=\"display:inline-block; width:60px; border-bottom:1px solid #000;\"></span> /\n  <span style=\"display:inline-block; width:60px; border-bottom:1px solid #000;\"></span> /\n  <span style=\"display:inline-block; width:60px; border-bottom:1px solid #000;\"></span> 20\n  <br>\n  <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\n  <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\n  <br><br>\n  \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\n  <br>\u0623-\n  <br>\u0628-\n  <div class=\"signature\">\n    <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0633\u0645: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\n    <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0642\u0633\u0645: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\n  </div>\n</div>\n\n<!-- \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u062b\u0627\u0646\u064a -->\n<div class=\"section\">\n  <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u062c\u0627\u0645\u0639\u0629:</h3>\n  <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\n  <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\n  <br><br>\n  \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\n  <br>\u0623-\n  <br>\u0628-\n  <div class=\"signature\">\n    <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\n    <div>\u0645\u0642\u0631\u0631 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\n  </div>\n</div>\n\n<!-- \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u062b\u0627\u0644\u062b -->\n<div class=\"section\">\n  <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0631\u0626\u064a\u0633 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629:</h3>\n  <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\n  <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\n  <br><br>\n  \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\n  <br>\u0623-\n  <br>\u0628-\n  <div class=\"signature\">\n    <div>\u0627\u0644\u0627\u0633\u0645: _____________</div>\n    <div>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________<br>\u0627\u0644\u062a\u0627\u0631\u064a\u062e: _____________</div>\n  </div>\n</div>\n\n<!-- \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a -->\n<div class=\"section\">\n  <h3>\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a:</h3>\n  <div class=\"note\">\n    (\u0661) \u064a\u062a\u0639\u0647\u062f \u0627\u0644\u0628\u0627\u062d\u062b \u0628\u0639\u062f\u0645 \u0633\u062d\u0628 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u062d\u062b \u0628\u0639\u062f \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0639\u0644\u064a\u0647. <br>\n    (\u0662) \u0644\u0627 \u064a\u062c\u0648\u0632 \u0646\u0634\u0631 \u0627\u0644\u0628\u062d\u062b \u0625\u0644\u0627 \u0628\u0639\u062f \u0627\u0633\u062a\u062d\u0635\u0627\u0644 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0646\u064a. <br>\n    (\u0663) \u064a\u064f\u0633\u0644\u0651\u0645 \u0627\u0644\u0628\u0627\u062d\u062b \u0646\u0633\u062e\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u0646 \u0627\u0644\u0628\u062d\u062b \u0625\u0644\u0649 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0644\u063a\u0631\u0636 \u0627\u0644\u0623\u0631\u0634\u0641\u0629. <br>\n    (\u0664) \u0641\u064a \u062d\u0627\u0644 \u0642\u0628\u0648\u0644 \u0627\u0644\u0628\u062d\u062b \u0644\u0644\u0646\u0634\u0631\u060c \u062a\u064f\u0642\u062f\u0651\u0645 \u0646\u0633\u062e\u0629 \u0645\u0646 \u0623\u0648\u0644 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0627\u0644\u0645\u062c\u0644\u0629 \u0625\u0644\u0649 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0646\u064a. <br>\n    (\u0665) \u0641\u064a \u062d\u0627\u0644 \u0648\u062c\u0648\u062f \u0623\u0643\u062b\u0631 \u0645\u0646 \u0628\u0627\u062d\u062b\u060c \u064a\u064f\u0630\u0643\u0631 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0643\u0645\u0627 \u0648\u0631\u062f \u0641\u064a \u0627\u0644\u0628\u062d\u062b. <br>\n  </div>\n</div>\n\n\n\n"
