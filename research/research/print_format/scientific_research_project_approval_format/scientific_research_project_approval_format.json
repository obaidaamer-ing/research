 "doc_type": "Scientific Research Project Approval Form",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html dir=\"rtl\" lang=\"ar\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>\u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0634\u0631\u0648\u0639 \u0628\u062d\u062b \u0639\u0644\u0645\u064a - \u0643\u0627\u0645\u0644</title>\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;600;700&family=Tajawal:wght@400;500;700&display=swap\" rel=\"stylesheet\">\r\n\r\n<style>\r\n    * { margin:0; padding:0; box-sizing:border-box; }\r\n    body { font-family:'Tajawal', sans-serif; direction:rtl; text-align:right; padding:20px; color:#111; }\r\n/* \u0627\u062c\u0639\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0643\u0644\u0647\u0627 \u0639\u0644\u0649 \u0635\u0641\u062d\u0629 \u0648\u0627\u062d\u062f\u0629 */\r\n.wrapper-second-page {\r\n    page-break-after: auto;   /* \u0628\u0639\u062f\u0647\u0627 \u0644\u0627 \u062a\u0643\u0633\u0631 \u0635\u0641\u062d\u0629 */\r\n    page-break-inside: avoid; /* \u0644\u0627 \u062a\u0642\u0633\u0645\u0647\u0627 \u0639\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0635\u0641\u062d\u0629 */\r\n}\r\n\r\n/* \u0645\u0646\u0639 \u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 */\r\n.wrapper-second-page .section {\r\n    page-break-after: auto !important;\r\n    page-break-inside: avoid !important;\r\n    margin-bottom: 10px; /* \u0642\u0644\u0644 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0628\u064a\u0646 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 */\r\n}\r\n\r\n    /* ---------- \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 ---------- */\r\n    .form-container {\r\n    width: 100%;\r\n    margin: 0 auto 40px auto;\r\n    background: white;\r\n    padding:20px;\r\n    box-shadow: 0 0 20px rgba(0,0,0,0.1);\r\n    position: relative;\r\n    page-break-after: always; /* \u062a\u0641\u0635\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 */\r\n    page-break-inside: avoid;\r\n        \r\n    }\r\n    \r\n\r\n    .header { display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; border-bottom:3px solid #b0b0b0; padding-bottom:20px; }\r\n    .logo { width:112px; height:100px; display:flex; align-items:center; justify-content:center; }\r\n    .header-text { text-align:center; flex:1; padding:0 20px; }\r\n    .header-text h1 { font-size:22px; color:#000; margin-bottom:10px; font-weight:bold; }\r\n    .header-text h2 { font-size:18px; color:#333; margin:5px 0; }\r\n\r\n    .date-section { text-align:right; margin:20px 0; font-size:16px; font-weight:bold; }\r\n    .date-fields { display:inline-flex; gap:10px; }\r\n    .date-field { width:60px; padding:5px; border:1px solid #333; text-align:center; }\r\n\r\n    .section-title { background:transparent; color:#000; padding:10px; font-size:16px; font-weight:bold; margin:20px 0 10px 0; border-radius:4px; }\r\n    .info-section { margin:20px 0; }\r\n    .info-section label { font-weight:bold; font-size:16px; margin-bottom:10px; display:block; color:#000; }\r\n    .info-section textarea, .info-section input[type=\"text\"] { width:100%; padding:10px; border:1px solid #ccc; border-radius:4px; font-family:inherit; font-size:14px; resize:vertical; }\r\n\r\n    table { width:100%; border-collapse:collapse; margin:20px 0; border:1px solid #333; direction:rtl; }\r\n    table th, table td { border:1px solid #333; padding:12px; text-align:center; font-size:14px; }\r\n\r\n    /* \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0623\u0648\u0644 */\r\n    .researchers-table th { color:#000; background-color:#f0f0f0; font-size:16px; font-weight:bold; text-align:center; }\r\n    .researchers-table input { width:100%; padding:8px; border:none; text-align:center; font-family:inherit; }\r\n\r\n    /* \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0623\u062e\u064a\u0631 */\r\n    .research-type-table { margin:20px 0; border-collapse:collapse; width:100%; }\r\n    .research-type-table th { background-color:transparent; color:#000 !important; font-weight:bold; padding:10px 15px; text-align:center; }\r\n    .research-type-table td { width:auto; padding:8px 25px; text-align:right; background:#fff; color:#000; }\r\n    .research-type-table td:empty { width:80px; }\r\n\r\n    .objectives-section { min-height:120px; border:1px solid #333; padding:10px; margin:20px 0; }\r\n    .footer-note { margin-top:20px; text-align:center; font-size:13px; font-style:italic; color:#666; }\r\n.second-page-container {\r\n   \r\n    width: 100%;\r\n\r\n    margin: 0 auto 40px auto;\r\n\r\n    background: white;\r\n    padding: 20px;\r\n\r\n    box-shadow: 0 0 15px rgba(0,0,0,0.1);\r\n\r\n    position: relative;\r\n\r\n    page-break-before: always;\r\n    page-break-inside: avoid;\r\n}\r\n.second-page-container label {\r\n\r\nfont-family: 'tajwal';\r\nfont-size: 14px;\r\ncolor: #000;    \r\n}\r\n\r\n    /* ---------- \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 ---------- */\r\n    .section {\r\n    width: calc(100% - 10px);   /* \u2b05\ufe0f \u064a\u0628\u0639\u062f \u0627\u0644\u0625\u0637\u0627\u0631 \u0639\u0646 \u062d\u062f\u0648\u062f \u0627\u0644\u0648\u0631\u0642\u0629 */\r\n    margin: 20px auto;          /* \u2b05\ufe0f \u0645\u0633\u0627\u0641\u0629 \u0645\u0646 \u0627\u0644\u0623\u0639\u0644\u0649 \u0648\u0627\u0644\u0623\u0633\u0641\u0644 \u0648\u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0646 */\r\nfont-family: 'tajwal', serif;   /* \u0646\u0648\u0639 \u0627\u0644\u062e\u0637 */\r\n    font-size: 14px;               /* \u062d\u062c\u0645 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 */\r\n    line-height: 1.9;              /* \u062a\u0628\u0627\u0639\u062f \u0627\u0644\u0623\u0633\u0637\u0631 */\r\n    color: #000;                   /* \u0644\u0648\u0646 \u0627\u0644\u0646\u0635 */\r\n    padding: 10px 20px;         /* \u2b05\ufe0f \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0628\u064a\u0646 \u0627\u0644\u0625\u0637\u0627\u0631 \u0648\u0627\u0644\u0646\u0635 */\r\n\r\n    background: transparent;\r\n\r\n    border: 1px solid #000;\r\n    border-radius: 0;\r\n\r\n    position: relative;\r\n\r\n    page-break-inside: avoid;\r\n}\r\n\r\n\r\n    \r\n    \r\n    .checkbox { display:inline-block; width:18px; height:18px; border:1px solid #000; margin:0 5px; }\r\n    .signature { margin-top:15px; display:flex; justify-content:space-between; }\r\n    .signature div { width:45%;}\r\n    .note { font-size:14px; margin-top:10px; }\r\n    h3 { margin-bottom:10px; color:#222; }\r\n\r\n    /* \u0637\u0628\u0627\u0639\u0629 \u0628\u062f\u0648\u0646 \u062d\u062f\u0648\u062f */\r\n    @media print {\r\n        body { background:white; padding:0;}\r\n        .form-container, .section { box-shadow:none; max-width:100%; page-break-after:always;}\r\n    }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- ===== \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 ===== -->\r\n<div class=\"form-container\">\r\n    <img src=\"/files/398187124_832924115292771_8632611931367621524_n.png\"\r\n     alt=\"\u0634\u0639\u0627\u0631 \u0627\u0644\u062c\u0627\u0645\u0639\u0629\"\r\n     style=\"\r\n       position: absolute;\r\n       top: 50%;\r\n       left: 50%;\r\n       width: 70%;\r\n       opacity: 0.18;\r\n       transform: translate(-50%, -50%);\r\n       z-index: 0;\r\n       pointer-events: none;\">\r\n\r\n    \r\n    <div class=\"content\">\r\n        <div class=\"header\">\r\n             \r\n               <div class=\"logo\" style=\"width:120px; height:120px; display:flex; align-items:center; justify-content:center;\">\r\n    <img src=\"/files/37171594305659483.png\"\r\n         style=\"width:120px !important; height:120px !important; object-fit:contain; border:none;\">\r\n</div>\r\n\r\n\r\n          \r\n            <div class=\"header-text\">\r\n                <h1>\u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0634\u0631\u0648\u0639 \u0628\u062d\u062b \u0639\u0644\u0645\u064a</h1>\r\n                <h2>\u0644\u0644\u0639\u0627\u0645 \u0627\u0644\u062f\u0631\u0627\u0633\u064a \u0662\u0660\u0662\u0666 / \u0662\u0660\u0662\u0667</h2>\r\n                <h2>\u062c\u0627\u0645\u0639\u0629 \u062a\u0644\u0639\u0641\u0631 / \u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u062c\u0627\u0645\u0639\u0629</h2>\r\n            </div>\r\n            <div class=\"logo\">\r\n                <img src=\"/files/398187124_832924115292771_8632611931367621524_n.png\" style=\"width:90px; height:90px; object-fit:cover; border:none;\">\r\n            </div>\r\n        </div>\r\n\r\n<div class=\"date-section\">\r\n    \u062a\u0627\u0631\u064a\u062e \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0631\u0629:\r\n    {{ doc.submission_date }}\r\n</div>\r\n\r\n\r\n\r\n        <p style=\"font-weight:bold; margin:20px 0;\">\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0641\u0636\u0644 \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u062a\u0641\u0627\u0635\u064a\u0644\u0647 \u0627\u062f\u0646\u0627\u0647:</p>\r\n\r\n       <div class=\"info-section\">\r\n    <label>\u0661) \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u062d\u062b:</label>\r\n    <textarea rows=\"3\">{{ doc.research_title or '' }}</textarea>\r\n</div>\r\n\r\n\r\n\r\n        <div class=\"section-title\">\u0662) \u0627\u0633\u0645\u0627\u0621 \u0627\u0644\u0628\u0627\u062d\u062b\u0648\u0646:</div>\r\n\r\n        <table class=\"researchers-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>\u062a</th>\r\n                    <th>\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u062d\u062b</th>\r\n                    <th>\u0627\u0644\u062a\u0631\u0628\u064a\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629</th>\r\n                    <th>\u062c\u0647\u0629 \u0627\u0644\u0627\u0646\u062a\u0633\u0627\u0628</th>\r\n                    <th>\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641</th>\r\n                    <th>\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a</th>\r\n                    <th>\u0627\u0644\u062a\u0648\u0642\u064a\u0639</th>\r\n                </tr>\r\n            </thead>\r\n           <tbody>\r\n{% for researcher in doc.researchers %}\r\n    <tr>\r\n        <td>{{ loop.index }}</td>\r\n        <td>{{ researcher.researcher_name }}</td>\r\n        <td>{{ researcher.academic_rank }}</td>\r\n        <td>{{ researcher.affiliation }}</td>\r\n        <td>{{ researcher.phone if researcher.phone else '' }}</td>\r\n        <td>{{ researcher.email }}</td>\r\n        <td>\r\n            {% if researcher.signature %}\r\n                <img src=\"{{ researcher.signature }}\" style=\"height:40px;\">\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n{% endfor %}\r\n</tbody>\r\n\r\n        </table>\r\n\r\n        <div class=\"section-title\">\u0645\u0648\u062c\u0632 \u0627\u0644\u0628\u062d\u062b \u0648\u0623\u0647\u062f\u0627\u0641\u0647:</div>\r\n<div class=\"objectives-section\">{{ doc.research_summary or '' }}</div>\r\n\r\n\r\n<table class=\"research-type-table\" style=\"margin-top:35px; border-collapse: collapse;\">\r\n    <tbody>\r\n        <tr>\r\n            <th style=\"font-size:14px; font-weight:bold; text-align:right; padding:2px 4px; white-space: nowrap; width:1%;\">\u0646\u0648\u0639 \u0627\u0644\u0628\u062d\u062b</th>\r\n            <td style=\"padding:2px 6px;\">{{ doc.research_type or '' }}</td>\r\n        </tr>\r\n        <tr>\r\n            <th style=\"font-size:14px; font-weight:bold; text-align:right; padding:2px 4px; white-space: nowrap; width:1%;\">\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0628\u062d\u062b</th>\r\n            <td style=\"padding:2px 6px;\">{{ doc.research_nature or '' }}</td>\r\n        </tr>\r\n        <tr>\r\n            <th style=\"font-size:14px; font-weight:bold; text-align:right; padding:2px 4px; white-space: nowrap; width:1%;\">\u0647\u0644 \u0627\u0644\u0628\u062d\u062b</th>\r\n            <td style=\"padding:2px 6px;\">{{ doc.research_status or '' }}</td>\r\n        </tr>\r\n        <tr>\r\n            <th style=\"font-size:14px; font-weight:bold; text-align:right; padding:2px 4px; white-space: nowrap; width:1%;\">\u062e\u0637\u0629 \u0627\u0644\u0628\u062d\u062b</th>\r\n            <td style=\"padding:2px 6px;\">{{ doc.research_plan or '' }}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n        <div class=\"footer-note\">\r\n            <p>\u0641\u064a \u062d\u0627\u0644 \u0643\u0648\u0646 \u0627\u0644\u0628\u0627\u062d\u062b \u0645\u062a\u0641\u0631\u063a\u0627\u064b\u060c \u064a\u064f\u0631\u0641\u0642 \u0627\u0644\u0628\u0627\u062d\u062b \u0645\u0633\u062a\u0645\u0633\u0643 \u0645\u0646 \u0627\u0648\u0644 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0645\u0646\u0634\u0648\u0631.</p>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<!-- ===== \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 ===== -->\r\n<!-- ===== \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 ===== -->\r\n<div class=\"wrapper-second-page\">\r\n  <div class=\"second-page-container\">\r\n\r\n  <div class=\"section\">\r\n    <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629:</h3>\r\n    \u0623\u0648\u0635\u062a \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0633\u0645 \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0627\u0644\u0645\u0631\u0642\u0645\u0629 (\r\n    <span style=\"display:inline-block; width:50px; border-bottom:1px solid #000;\"></span> ) \u0628\u062a\u0627\u0631\u064a\u062e\r\n    <span style=\"display:inline-block; width:20px; border-bottom:1px solid #000;\"></span> /\r\n    <span style=\"display:inline-block; width:20px; border-bottom:1px solid #000;\"></span> /\r\n    <span style=\"display:inline-block; width:40px; border-bottom:1px solid #000;\"></span> 20\r\n    <br>\r\n    <br>\r\n    <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\r\n    <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\r\n    <br>\r\n    \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\r\n    <br>\u0623-\r\n    <br>\u0628-\r\n    <div class=\"signature\">\r\n      <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0633\u0645: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\r\n      <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0642\u0633\u0645: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"section\">\r\n    <img src=\"/files/398187124_832924115292771_8632611931367621524_n.png\"\r\n         alt=\"\u0634\u0639\u0627\u0631 \u0627\u0644\u062c\u0627\u0645\u0639\u0629\"\r\n         style=\"position: absolute; top: 50%; left: 50%; width: 85%; opacity: 0.18; transform: translate(-50%, -50%); z-index: 0; pointer-events: none;\">\r\n\r\n    <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0641\u064a \u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u062c\u0627\u0645\u0639\u0629:</h3>\r\n    <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\r\n    <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\r\n    <br>\r\n    \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\r\n    <br>\u0623-\r\n    <br>\u0628-\r\n    <div class=\"signature\">\r\n      <div>\u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\r\n      <div>\u0645\u0642\u0631\u0631 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629: _____________<br>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"section\">\r\n    <h3>\u0645\u0635\u0627\u062f\u0642\u0629 \u0631\u0626\u064a\u0633 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629:</h3>\r\n    <label><span class=\"checkbox\"></span> \u0623\u0648\u0627\u0641\u0642</label>\r\n    <label><span class=\"checkbox\"></span> \u0644\u0627 \u0623\u0648\u0627\u0641\u0642</label>\r\n    <br>\r\n    \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u062a\u064f\u0630\u0643\u0631 \u0627\u0644\u0623\u0633\u0628\u0627\u0628:\r\n    <br>\u0623-\r\n    <br>\u0628-\r\n    <div class=\"signature\">\r\n      <div>\u0627\u0644\u0627\u0633\u0645: _____________</div>\r\n      <div>\u0627\u0644\u062a\u0648\u0642\u064a\u0639: _____________<br>\u0627\u0644\u062a\u0627\u0631\u064a\u062e: _____________</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"section\">\r\n    <h3>\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a:</h3>\r\n    <div class=\"note\">\r\n      (\u0661) \u064a\u062a\u0639\u0647\u062f \u0627\u0644\u0628\u0627\u062d\u062b \u0628\u0639\u062f\u0645 \u0633\u062d\u0628 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u062d\u062b \u0628\u0639\u062f \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0639\u0644\u064a\u0647. <br>\r\n      (\u0662) \u0644\u0627 \u064a\u062c\u0648\u0632 \u0646\u0634\u0631 \u0627\u0644\u0628\u062d\u062b \u0625\u0644\u0627 \u0628\u0639\u062f \u0627\u0633\u062a\u062d\u0635\u0627\u0644 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0646\u064a. <br>\r\n      (\u0663) \u064a\u064f\u0633\u0644\u0651\u0645 \u0627\u0644\u0628\u0627\u062d\u062b \u0646\u0633\u062e\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u0646 \u0627\u0644\u0628\u062d\u062b \u0625\u0644\u0649 \u0642\u0633\u0645 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0644\u063a\u0631\u0636 \u0627\u0644\u0623\u0631\u0634\u0641\u0629. <br>\r\n      (\u0664) \u0641\u064a \u062d\u0627\u0644 \u0642\u0628\u0648\u0644 \u0627\u0644\u0628\u062d\u062b \u0644\u0644\u0646\u0634\u0631\u060c \u062a\u064f\u0642\u062f\u0651\u0645 \u0646\u0633\u062e\u0629 \u0645\u0646 \u0623\u0648\u0644 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0627\u0644\u0645\u062c\u0644\u0629 \u0625\u0644\u0649 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0646\u064a. <br>\r\n      (\u0665) \u0641\u064a \u062d\u0627\u0644 \u0648\u062c\u0648\u062f \u0623\u0643\u062b\u0631 \u0645\u0646 \u0628\u0627\u062d\u062b\u060c \u064a\u064f\u0630\u0643\u0631 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0643\u0645\u0627 \u0648\u0631\u062f \u0641\u064a \u0627\u0644\u0628\u062d\u062b. <br>\r\n     \r\n    </div>\r\n  </div>\r\n</div>",
